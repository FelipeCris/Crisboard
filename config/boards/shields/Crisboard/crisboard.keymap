#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define COLEMAK 0
#define QWERTY 1
#define LOWER 2

/ {
    behaviors {
        cb_preset: crisboard_rgb_preset {
            compatible = "zmk,behavior-crisboard-rgb-preset";
            label = "CB_RGB_PRESET";
            #binding-cells = <1>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            label = "CLMK";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
                &kp CAPS  &kp Q  &kp W  &kp F  &kp P  &kp G  &kp GRAVE  &kp RBKT  &kp J  &kp L  &kp U  &kp Y  &kp SEMI  &kp BSPC
                &kp TAB  &kp A  &kp R  &kp S  &kp T  &kp D  &none  &kp RALT  &kp H  &kp N  &kp E  &kp I  &kp O  &kp DOT
                &kp LSHFT  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp SPACE  &kp ENTER  &kp B  &kp K  &kp M  &kp FSLH  &kp UP  &kp MINUS
                &kp LCTRL  &mo LOWER  &kp LWIN  &kp LALT  &kp LBKT  &kp COMMA  &kp HOME  &kp END  &kp SPACE  &kp APOS  &kp BSLH  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };
        rise_layer {
            label = "QWRTY";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
                &kp CAPS  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp GRAVE  &kp RBKT  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &none  &kp RALT  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp LBKT
                &kp LSHFT  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp SPACE  &kp ENTER  &kp B  &kp N  &kp M  &kp FSLH  &kp UP  &kp MINUS
                &kp LCTRL  &mo LOWER  &kp LWIN  &kp LALT  &kp DOT  &kp COMMA  &kp HOME  &kp END  &kp SPACE  &kp APOS  &kp BSLH  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };
        lower_layer {
            label = "Lower";
            bindings = <
                &rgb_ug RGB_TOG  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &to QWERTY  &to COLEMAK  &cb_preset 0  &cb_preset 1  &cb_preset 2  &cb_preset 3  &cb_preset 4  &kp F12
                &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &kp S  &kp D  &kp F  &out OUT_TOG  &none  &none  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp DOT
                &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &kp Z  &kp X  &kp C  &kp V  &kp PRINTSCREEN  &kp C_MUTE  &kp B  &kp N  &none  &rgb_ug RGB_SPD  &kp C_VOLUME_UP  &rgb_ug RGB_SPI
                &kp LCTRL  &kp LWIN  &none  &kp LALT  &kp LBKT  &kp COMMA  &kp HOME  &kp END  &kp C_PLAY_PAUSE  &kp APOS  &kp BSLH  &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_NEXT
            >;
        };
    };
};
