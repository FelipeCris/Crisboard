#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

// Fn has higher priority than both base layouts.
#define COLEMAK 0
#define QWERTY 1
#define LOWER 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Colemak: installed letters and punctuation.
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
                &kp CAPS  &kp Q  &kp W  &kp F  &kp P  &kp G  &kp GRAVE  &kp RBKT  &kp J  &kp L  &kp U  &kp Y  &kp SEMI  &kp BSPC
                &kp TAB  &kp A  &kp R  &kp S  &kp T  &kp D  &trans  &kp RALT  &kp H  &kp N  &kp E  &kp I  &kp O  &kp DOT
                &kp LSHFT  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp SPACE  &kp ENTER  &kp B  &kp K  &kp M  &kp FSLH  &kp UP  &kp MINUS
                &kp LCTRL  &mo LOWER  &kp LWIN  &kp LALT  &kp LBKT  &kp COMMA  &kp HOME  &kp END  &kp SPACE  &kp APOS  &kp BSLH  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        rise_layer {
            // QWERTY: Fn and Win now share their Colemak/QMK positions.
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
                &kp CAPS  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp GRAVE  &kp RBKT  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &trans  &kp RALT  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp LBKT
                &kp LSHFT  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp SPACE  &kp ENTER  &kp B  &kp N  &kp M  &kp FSLH  &kp UP  &kp MINUS
                &kp LCTRL  &mo LOWER  &kp LWIN  &kp LALT  &kp DOT  &kp COMMA  &kp HOME  &kp END  &kp SPACE  &kp APOS  &kp BSLH  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        lower_layer {
            // Fn: physical Colemak W/F/P = BT1/BT2/BT3; G = clear selected bond; D = USB/BLE.
            // Inner selectors: left = QWERTY, right = Colemak. Other Fn bindings are preserved.
            bindings = <
                &rgb_ug RGB_TOG  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &to QWERTY  &to COLEMAK  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp F12
                &trans  &trans  &trans  &trans  &trans  &out OUT_TOG  &trans  &kp RALT  &kp H  &kp J  &kp K  &kp L  &trans  &rgb_ug RGB_EFF
                &trans  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp SPACE  &kp ENTER  &kp B  &kp N  &kp M  &rgb_ug RGB_SPD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI
                &trans  &mo LOWER  &kp LWIN  &kp LALT  &kp DOT  &kp COMMA  &kp HOME  &kp END  &kp SPACE  &kp APOS  &kp BSLH  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI
            >;
        };
    };
};
