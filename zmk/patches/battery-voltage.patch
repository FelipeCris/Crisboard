@@ -6,4 +6,9 @@
 
 #pragma once
 
+#include <stdint.h>
+
 uint8_t zmk_battery_state_of_charge();
+
+/* Millivolts from the last successful sample; -1 until available. */
+int32_t zmk_battery_voltage_mv(void);
--- a/app/src/battery.c
+++ b/app/src/battery.c
@@ -20,6 +20,10 @@
 #include <zmk/events/battery_state_changed.h>
 
 static uint8_t last_state_of_charge = 0;
+#if IS_ENABLED(CONFIG_ZMK_WIDGET_BATTERY_STATUS_SHOW_VOLTAGE)
+static int32_t last_voltage_mv = -1;
+int32_t zmk_battery_voltage_mv(void) { return last_voltage_mv; }
+#endif
 
 uint8_t zmk_battery_state_of_charge() { return last_state_of_charge; }
 
@@ -48,7 +52,22 @@
         return rc;
     }
 
-    if (last_state_of_charge != state_of_charge.val1) {
+    bool voltage_changed = false;
+#if IS_ENABLED(CONFIG_ZMK_WIDGET_BATTERY_STATUS_SHOW_VOLTAGE)
+    /* The sensor already cached voltage during the existing ADC sample. */
+    struct sensor_value voltage;
+    int voltage_rc = sensor_channel_get(battery, SENSOR_CHAN_GAUGE_VOLTAGE, &voltage);
+    if (voltage_rc == 0) {
+        int32_t mv = voltage.val1 * 1000 + voltage.val2 / 1000;
+        voltage_changed = last_voltage_mv != mv;
+        last_voltage_mv = mv;
+    } else {
+        LOG_DBG("Failed to get cached battery voltage: %d", voltage_rc);
+    }
+#endif
+
+    bool level_changed = last_state_of_charge != state_of_charge.val1;
+    if (level_changed) {
         last_state_of_charge = state_of_charge.val1;
 
         LOG_DBG("Setting BAS GATT battery level to %d.", last_state_of_charge);
@@ -60,6 +79,10 @@
             return rc;
         }
 
+    }
+
+    /* Voltage can change while the estimated percentage stays the same. */
+    if (level_changed || voltage_changed) {
         rc = ZMK_EVENT_RAISE(new_zmk_battery_state_changed(
             (struct zmk_battery_state_changed){.state_of_charge = last_state_of_charge}));
     }
