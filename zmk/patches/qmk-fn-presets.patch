diff --git a/app/src/rgb_underglow.c b/app/src/rgb_underglow.c
index 25d4466..8320607 100644
--- a/app/src/rgb_underglow.c
+++ b/app/src/rgb_underglow.c
@@ -18,6 +18,7 @@
 #include <drivers/ext_power.h>
 
 #include <zmk/rgb_underglow.h>
+#include <zmk/crisboard_rgb_presets.h>
 
 #include <zmk/activity.h>
 #include <zmk/usb.h>
@@ -291,6 +292,30 @@ int zmk_rgb_underglow_save_state() {
 #endif
 }
 
+int zmk_rgb_underglow_get_snapshot(uint32_t *snapshot) {
+    if (!led_strip) {
+        return -ENODEV;
+    }
+    *snapshot = crisboard_rgb_pack(state.color.h, state.color.s, state.color.b,
+        state.animation_speed, state.current_effect, state.on);
+    return crisboard_rgb_valid(*snapshot, UNDERGLOW_EFFECT_NUMBER) ? 0 : -EINVAL;
+}
+
+int zmk_rgb_underglow_apply_snapshot(uint32_t snapshot) {
+    if (!led_strip) {
+        return -ENODEV;
+    }
+    if (!crisboard_rgb_valid(snapshot, UNDERGLOW_EFFECT_NUMBER)) {
+        return -EINVAL;
+    }
+    state.color = (struct zmk_led_hsb){.h = snapshot & 511,
+        .s = (snapshot >> 9) & 127, .b = (snapshot >> 16) & 127};
+    state.animation_speed = (snapshot >> 23) & 7;
+    state.current_effect = (snapshot >> 26) & 7;
+    state.animation_step = 0;
+    return (snapshot & BIT(29)) ? zmk_rgb_underglow_on() : zmk_rgb_underglow_off();
+}
+
 int zmk_rgb_underglow_get_state(bool *on_off) {
     if (!led_strip)
         return -ENODEV;
