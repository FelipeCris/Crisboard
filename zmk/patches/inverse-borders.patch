+static void zmk_rgb_underglow_effect_borders() {
+    struct zmk_led_hsb inverse = state.color;
+    inverse.h = (inverse.h + HUE_MAX / 2) % HUE_MAX;
+    const struct led_rgb base_rgb = hsb_to_rgb(hsb_scale_min_max(state.color));
+    const struct led_rgb border_rgb = hsb_to_rgb(hsb_scale_min_max(inverse));
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        pixels[i] = crisboard_colemak_base && crisboard_rgb_is_border(i) ? border_rgb : base_rgb;
+    }
+}
