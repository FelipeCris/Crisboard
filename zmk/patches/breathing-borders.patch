+static void zmk_rgb_underglow_effect_borders_breathe() {
+    struct zmk_led_hsb inverse = state.color;
+    inverse.h = (inverse.h + HUE_MAX / 2) % HUE_MAX;
+    const struct led_rgb border_rgb = hsb_to_rgb(hsb_scale_min_max(inverse));
+    struct zmk_led_hsb center = state.color;
+    center.b = state.color.b * abs(state.animation_step - 1200) / 1200;
+    const struct led_rgb center_rgb = hsb_to_rgb(hsb_scale_zero_max(center));
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        pixels[i] = crisboard_colemak_base && crisboard_rgb_is_border(i) ? border_rgb : center_rgb;
+    }
+    state.animation_step += state.animation_speed * 10;
+    if (state.animation_step > 2400) {
+        state.animation_step = 0;
+    }
+}
